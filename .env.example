# FPOA — Configuração
# ⚠️ NUNCA commitar este arquivo. Use para credenciais DO CLIENTE.

# --- Google Sheets (planilha mestre "FPRIME OPS") ---
# Criada/operada na conta do CLIENTE. Nenhuma conta do autor é usada.
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/sheets_client.json
FPRIME_SPREADSHEET_ID=

# --- Gmail (comunicação com fábricas/lojistas) ---
GMAIL_CREDENTIALS_FILE=credentials/gmail_client.json
GMAIL_SENDER=

# --- Telegram (interface do operador) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Regras de negócio (padrões; ajustar por cliente) ---
DEFAULT_COMISSAO_PCT=5.0
FOLLOWUP_HORAS=48
RECOMPRA_DIAS=45
DIVERGENCIA_LIMITE_REAL=100.0
FABRICA_INATIVA_DIAS=90